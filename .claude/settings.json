{
  "env": {
    "BASH_MAX_TIMEOUT_MS": "1800000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-unbounded-bash.sh"
          }
        ]
      }
    ]
  }
}
